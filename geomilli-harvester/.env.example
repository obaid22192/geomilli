# Copy this file to .env and adjust values
# cp .env.example .env

# Target Countries (comma-separated ISO-2 codes, e.g. BE or BE,NL,LU or ALL)
# Defaults to Belgium (BE) for fast 2-minute local setup
COUNTRIES=BE

# Harvester Daemon & HTTP/SSE Server
HARVESTER_PORT=8085
AUTO_IMPORT=true

# Meilisearch Connection (Local container or Meilisearch Cloud)
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=

# Index Configuration
DEFAULT_INDEX_NAME=places
DEFAULT_INDEX_GLOB=staging/places_??.ndjson
INDEX_BATCH_SIZE=2000
INDEX_MAX_IN_FLIGHT=2

# Wikidata / Wikipedia Enrichment
ENRICH_ONLINE=false
ENRICH_CACHE_DB=data/cache/enrichment.sqlite
ENRICH_CACHE_TTL_DAYS=30
ENRICH_QPS=3
ENRICH_WORKERS=8

# Data source URLs (override if needed)
OSM_GEOFABRIK_BASE_URL=https://download.geofabrik.de

# OSMIUM backend selection: auto | local | docker
OSMIUM_MODE=local
OSMIUM_DOCKER_IMAGE=iboates/osmium:latest
OSMIUM_DOCKER_PLATFORM=
