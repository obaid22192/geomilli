# ==============================================================================
# Geomilli Unified Environment Configuration
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Ingestion & Country Selection
# ------------------------------------------------------------------------------
# Comma-separated ISO alpha-2 country codes to ingest (default: BE - Belgium).
# Examples:
#   COUNTRIES=BE           # Fast 60-90s initial bootstrap (~70MB download)
#   COUNTRIES=BE,NL,LU     # Benelux region
#   COUNTRIES=ALL          # Ingest all supported countries
COUNTRIES=BE

# ------------------------------------------------------------------------------
# Meilisearch Connection (Local Docker or Meilisearch Cloud)
# ------------------------------------------------------------------------------
# For Local Docker:
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=masterKey123

# For Meilisearch Cloud:
# MEILI_HOST=https://ms-xxxx.sfo.meilisearch.io
# MEILI_API_KEY=your_cloud_admin_api_key

# ------------------------------------------------------------------------------
# Service Ports (Local dev and Docker host port mappings)
# ------------------------------------------------------------------------------
# Geomilli REST API port (change to e.g. 8000, 8080, 8888)
API_PORT=8080
PORT=8080

# Geomilli Harvester Daemon port (HTTP & SSE, default: 8085)
HARVESTER_PORT=8085

# Geomilli Studio UI Dashboard port (change to e.g. 3001, 3333, 5173 if 3000 is occupied)
STUDIO_PORT=3000

# Meilisearch Admin UI (eyeix/meilisearch-ui) port (default: 7701)
MEILI_UI_PORT=7701

# ------------------------------------------------------------------------------
# Model Context Protocol (MCP) Server
# ------------------------------------------------------------------------------
# Geomilli MCP Server port (Streamable HTTP transport, default: 8090)
MCP_PORT=8090

# Bearer authentication token for HTTP transport (required if binding non-loopback)
MCP_AUTH_TOKEN=

# Enable Tier-2 operations and monitoring tools (default: false)
MCP_ENABLE_OPS_TOOLS=false

# ------------------------------------------------------------------------------
# Harvester Pipeline & Enrichment Settings
# ------------------------------------------------------------------------------
# Enable online queries to Wikidata and Wikipedia Pageviews API.
# When false, uses deterministic offline heuristics.
ONLINE_ENRICH=false

# SQLite WAL Cache location and retention
DATA_DIR=./data
ENRICH_CACHE_TTL_DAYS=30
ENRICH_QPS=3

# Geofabrik OpenStreetMap mirror base URL
OSM_GEOFABRIK_BASE_URL=https://download.geofabrik.de
